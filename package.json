{
  "name": "williamslarry-cloudflare-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --kv=ENQUIRY_KV",
    "deploy": "wrangler pages deploy public --project-name williamslarry-logistics",
    "test": "node --test tests/*.test.js",
    "test:shipments": "node --test tests/admin-auth.test.js tests/shipments.test.js",
    "d1:migrate:local": "npx --yes wrangler@latest d1 migrations apply wll-shipments --local --config wrangler.local.jsonc"
  }
}
